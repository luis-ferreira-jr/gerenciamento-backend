# Copie para .env (nao commitado) ou configure como secrets no host de deploy (Fly.io/Railway).

# String de conexao do Neon convertida para o formato JDBC:
# painel do Neon da algo como: postgresql://usuario:senha@ep-xxx.neon.tech/dbname?sslmode=require
# converta para: jdbc:postgresql://ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=jdbc:postgresql://ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_USERNAME=usuario_do_neon
DATABASE_PASSWORD=senha_do_neon

# Dominio(s) do frontend publicado no Vercel, separados por virgula
CORS_ALLOWED_ORIGINS=https://seu-app.vercel.app,http://localhost:4200
